generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

enum TicketCategory {
  HARDWARE
  RETI_DNS
  SISTEMI_OPERATIVI
  SOFTWARE_OFFICE
  SICUREZZA
}

enum TicketPriority {
  BASSA
  MEDIA
  ALTA
  CRITICA
}

enum TicketStatus {
  TODO
  IN_PROGRESS
  WAITING_REVIEW
  RESOLVED
}

enum Difficulty {
  BASE
  INTERMEDIO
  AVANZATO
}

enum CommentAuthorType {
  STUDENT
  CLIENT
  TEACHER
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  xp            Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  ownedClassrooms       Classroom[]           @relation("ClassroomOwner")
  memberships           ClassroomMembership[]
  createdTickets        Ticket[]              @relation("TicketCreator")
  assignments           TicketAssignment[]
  comments              TicketComment[]
  evaluationsGiven      Evaluation[]          @relation("EvaluationTeacher")
  gameScores            GameScore[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Classroom {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  description    String?
  googleCourseId String?
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner       User                  @relation("ClassroomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships ClassroomMembership[]
  tickets     Ticket[]
}

model ClassroomMembership {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
}

model Ticket {
  id              String         @id @default(cuid())
  classroomId     String
  createdById     String
  title           String
  description     String
  category        TicketCategory
  priority        TicketPriority
  difficulty      Difficulty     @default(INTERMEDIO)
  slaMinutes      Int            @default(60)
  fakeLogs        String         @default("[]")
  attachmentsMeta String         @default("[]")
  secretNotes     String
  clientHints     String         @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  classroom   Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignments TicketAssignment[]
}

model TicketAssignment {
  id              String       @id @default(cuid())
  ticketId        String
  assigneeId      String
  status          TicketStatus @default(TODO)
  startedAt       DateTime?
  submittedAt     DateTime?
  resolvedAt      DateTime?
  rootCause       String?
  resolutionSteps String?
  finalTest       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ticket      Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee    User            @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  comments    TicketComment[]
  evaluation  Evaluation?
  hintIndex   Int             @default(0)

  @@unique([ticketId, assigneeId])
}

model TicketComment {
  id           String            @id @default(cuid())
  assignmentId String
  authorId     String?
  authorType   CommentAuthorType
  body         String
  createdAt    DateTime          @default(now())

  assignment TicketAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Evaluation {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  teacherId    String
  grade        Int
  xpAwarded    Int      @default(0)
  feedback     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment TicketAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  teacher    User             @relation("EvaluationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
}

model GameScore {
  id        String   @id @default(cuid())
  userId    String
  gameKey   String
  score     Int
  xpEarned  Int      @default(0)
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameKey])
}
