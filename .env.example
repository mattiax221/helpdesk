# Database
# Locale: SQLite
DATABASE_URL="file:./dev.db"
# Vercel/produzione: usa Neon/Supabase Postgres (pooled URL consigliata)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# SEED_ON_DEPLOY="1"  # solo al primo deploy se vuoi dati demo

# Auth.js / NextAuth — REQUIRED (no fallback in code)
AUTH_SECRET="genera-una-stringa-casuale-lunga"
# Locale:
AUTH_URL="http://127.0.0.1:3456"
# Su Vercel: AUTH_URL="https://TUO-PROGETTO.vercel.app"
# (NextAuth v5 legge anche AUTH_TRUST_HOST=true su hosting)

# Google OAuth + Classroom (opzionale)
# Scope predisposti: classroom.courses.readonly, classroom.rosters.readonly
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails allowed to become TEACHER on first Google sign-in.
# Without this list, new Google users remain STUDENT.
TEACHER_EMAIL_ALLOWLIST=""

# AI ticket generator: mock | openai | gemini
AI_PROVIDER="mock"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
